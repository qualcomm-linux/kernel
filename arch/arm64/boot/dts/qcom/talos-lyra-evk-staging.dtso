/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

/*
 * QPS615 ethernet with the QCA8081 SGMII PHY card in the M.2 E-key slot.
 *
 * The PHY power-enable and reset lines are driven by the TCA9538 I2C GPIO
 * expander (expander2) at 0x38 on APPS_I2C5 (i2c5):
 *   P0 EXP_ETH1_PWR_EN  P1 EXP_ETH1_INT_N  P2 EXP_ETH1_RST_N  P3 EXP_ETH0_INT_N
 *   P4 EXP_NVME_PLA_N   P5 EXP_NVME_PLN_N  P6 EXP_ETH0_PWR_EN P7 EXP_ETH0_RST_N
 *
 * ETH0 is QPS615 function 0 (05:00.0), ETH1 is function 1 (05:00.1), both
 * behind QPS615 downstream port 3 (pcie@3,0, bus 5). ASPM L0s/L1 is
 * disabled on the QPS615 links: L0s/L1 exit latency stalls RX DMA and
 * overflows the MAC RX FIFO.
 */

&{/} {
	eth0_phy_vreg: regulator-eth0-phy {
		compatible = "regulator-fixed";
		regulator-name = "eth0_phy_pwr";

		gpio = <&expander2 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <10000>;
	};

	eth1_phy_vreg: regulator-eth1-phy {
		compatible = "regulator-fixed";
		regulator-name = "eth1_phy_pwr";

		gpio = <&expander2 0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <10000>;
	};
};

&expander2 {
	vcc-supply = <&vreg_1p8>;

	gpio-line-names = "EXP_ETH1_PWR_EN", "EXP_ETH1_INT_N",
			  "EXP_ETH1_RST_N", "EXP_ETH0_INT_N",
			  "EXP_NVME_PLA_N", "EXP_NVME_PLN_N",
			  "EXP_ETH0_PWR_EN", "EXP_ETH0_RST_N";
};

&tc9563 {
	aspm-no-l1;
	aspm-no-l0s;

	pcie@3,0 {
		reg = <0x21800 0x0 0x0 0x0 0x0>;
		aspm-no-l1;
		aspm-no-l0s;

		pci@0,0 {
			reg = <0x50000 0x0 0x0 0x0 0x0>;
			aspm-no-l1;
			aspm-no-l0s;
			phy-mode = "sgmii";
			phy-supply = <&eth0_phy_vreg>;
			phy-reset-gpios = <&expander2 7 GPIO_ACTIVE_LOW>;
			reset-deassert-us = <221000>;
		};

		pci@0,1 {
			reg = <0x50100 0x0 0x0 0x0 0x0>;
			aspm-no-l1;
			aspm-no-l0s;
			phy-mode = "sgmii";
			phy-supply = <&eth1_phy_vreg>;
			phy-reset-gpios = <&expander2 2 GPIO_ACTIVE_LOW>;
			reset-deassert-us = <20000>;
		};
	};
};
