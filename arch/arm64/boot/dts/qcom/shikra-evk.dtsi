&iris {
	firmware-name = "qcom/vpu/ar50lt_p1_gen2_s6.mbn";

	status = "okay";
};

&psci {
	reboot-mode {
		mode-bootloader = <0x10001 0x2>;
		mode-edl = <0 0x1>;
	};
};

&qupv3_0 {
	firmware-name = "qcom/shikra/qupv3fw.elf";
	status = "okay";
};

&tlmm {
	sw_ctrl_default: sw-ctrl-default-state {
		pins = "gpio88";
		function = "gpio";
		bias-pull-down;
	};
};

&uart0 {
	status = "okay";
};

&uart8 {
	bluetooth {
		compatible = "qcom,wcn3988-bt";
		max-speed = <3200000>;
	};
};
