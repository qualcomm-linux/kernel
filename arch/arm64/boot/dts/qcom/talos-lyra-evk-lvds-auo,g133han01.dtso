/dts-v1/;
/plugin/;

#include <dt-bindings/clock/qcom,qcs615-gcc.h>
#include <dt-bindings/clock/qcom,rpmh.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

&{/} {
	bklt_pwm: pwm {
		compatible = "clk-pwm";
		#pwm-cells = <2>;
		assigned-clock-parents = <&rpmhcc RPMH_CXO_CLK>;
		assigned-clocks = <&gcc GCC_GP3_CLK_SRC>;
		clocks = <&gcc GCC_GP3_CLK>;
		pinctrl-0 = <&bklt_pwm_default>;
		pinctrl-names = "default";
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&bklt_pwm 0 100000>;
		power-supply = <&vreg_disp_3p3>;
		enable-gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <128>;
	};

	panel-lvds {
		compatible = "auo,g133han01";
		power-supply = <&vreg_disp_3p3>;
		backlight = <&backlight>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* LVDS Channel A — odd pixels */
			port@0 {
				reg = <0>;
				dual-lvds-odd-pixels;

				lvds_panel_out_a: endpoint {
					remote-endpoint = <&sn65dsi84_out_a>;
				};
			};

			/* LVDS Channel B — even pixels */
			port@1 {
				reg = <1>;
				dual-lvds-even-pixels;

				lvds_panel_out_b: endpoint {
					remote-endpoint = <&sn65dsi84_out_b>;
				};
			};
		};
	};

};

&hdmi_connector {
	status = "disabled";
};

&i2c5 {
	#address-cells = <1>;
	#size-cells = <0>;

	bridge@2c {
		compatible = "ti,sn65dsi84";
		reg = <0x2c>;
		enable-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&tlmm 60 IRQ_TYPE_EDGE_FALLING>;
		vcc-supply = <&vreg_s4a>;

		pinctrl-0 = <&bridge_irq_pin &bridge_rst_pin>;
		pinctrl-names = "default";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				sn65dsi84_in: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
					data-lanes = <1 2 3 4>;
				};
			};

			port@2 {
				reg = <2>;

				sn65dsi84_out_a: endpoint {
					data-lanes = <1 2 3 4>;
					remote-endpoint = <&lvds_panel_out_a>;
				};
			};

			port@3 {
				reg = <3>;

				sn65dsi84_out_b: endpoint {
					data-lanes = <1 2 3 4>;
					remote-endpoint = <&lvds_panel_out_b>;
				};
			};
		};
	};
};

&hdmi_bridge {
	status = "disabled";
};

&tlmm {
	bklt_pwm_default: bklt-pwm-default-state {
		pins = "gpio59";
		function = "gcc_gp";
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&sn65dsi84_in>;
	data-lanes = <0 1 2 3>;
};
