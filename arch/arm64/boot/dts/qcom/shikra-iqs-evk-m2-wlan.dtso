/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

&{/} {
	m2_keye_3p3: regulator-m2-keye-3p3 {
		compatible = "regulator-fixed";
		regulator-name = "VREG_3P3_KEYE";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&qps_gpio_expander 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		startup-delay-us = <100000>;
	};
};

&{/wcn3988-pmu} {
	status = "disabled";
};

&i2c3 {
	qps_gpio_expander: gpio@3c {
		compatible = "nxp,pca9534";
		reg = <0x3c>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

&pcie {
	iommu-map = <0x0 &apps_smmu 0x0800 0x0 0x1>,
		    <0x100 &apps_smmu 0x0801 0x0 0x1>;
	vddpe-3v3-supply = <&m2_keye_3p3>;
};

&pcie_port0 {
	reset-gpios = <&tlmm 118 GPIO_ACTIVE_LOW>;
};

&tc9563 {
	/* Keep the disabled switch node from matching the direct endpoint. */
	reg = <0x1ff00 0x0 0x0 0x0 0x0>;
	status = "disabled";
};

&wifi {
	status = "disabled";
};

&tlmm {
	wcn_wlan_en_hog: wcn-wlan-en-hog {
		gpio-hog;
		gpios = <61 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "wl-en-boot-config-1";
	};
};
